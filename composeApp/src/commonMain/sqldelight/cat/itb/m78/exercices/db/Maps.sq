CREATE TABLE SaveMarkers(
    id INTEGER PRIMARY KEY NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    imageUri TEXT
);

selectAll:
SELECT * FROM SaveMarkers;

selectById:
SELECT * FROM SaveMarkers WHERE id = ?;

insert:
INSERT INTO SaveMarkers(
    latitude,
    longitude,
    title,
    description,
    imageUri
) VALUES (?, ?, ?, ?, ?);

delete:
DELETE FROM SaveMarkers WHERE id = ?;